API_PORT=8000
FLASK_DEBUG=true
# String de conexao do banco relacional (SQLAlchemy). Sem essa variavel, cai no
# fallback SQLite local em backend/database/hub.db (ver config.py). Pra usar
# Postgres (local ou Neon), descomente e ajuste:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/hub
DATA_PROVIDER=google_drive
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_DATA_FILE=hub-data.json
# 'drive.readonly' NAO É SUFICIENTE MAIS -- upload de Documento (document_service.py)
# precisa de escrita. 'drive' (acesso completo) porque a busca legada (drive_routes.py
# /search) precisa listar arquivos que ja existiam no Drive antes do HUB, o que o
# escopo mais restrito 'drive.file' nao permite (so enxerga o que o proprio app criou).
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
FRONTEND_URL=http://localhost:5173
SQL_DRIVER=
SQL_HOST=
SQL_PORT=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
# "Senha da familia" pro botao de auto-cadastro na tela de login. Vazio = essa
# funcionalidade fica desligada (padrao seguro). Defina algo tipo uma frase
# curta e avise so quem deve se cadastrar (familia, por exemplo) -- quem nao
# souber o codigo nao consegue criar conta sozinho, mesmo achando a URL.
SIGNUP_CODE=
SECRET_ENCRYPTION_KEY=
SECRET_KEY=
VITE_API_BASE_URL=http://localhost:8000
