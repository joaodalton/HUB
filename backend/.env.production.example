# Modelo de referencia pras variaveis de PRODUCAO (Render). Nao e lido por
# nenhum codigo -- backend/.env so existe pra dev local (ver config.py, que
# usa python-dotenv). Em producao essas variaveis vao direto no painel do
# Render (ou num render.yaml, se preferir infra-as-code), nunca em arquivo.
#
# Regra geral: NENHUMA delas reaproveita valor de dev. Gerar tudo de novo.

# --- Banco ---
# Connection string do projeto Neon de PRODUCAO (separado do Neon de dev que
# ja esta configurado hoje -- Neon suporta branching, mas um projeto a parte
# tambem funciona e evita qualquer chance de misturar dado de teste com real).
DATABASE_URL=

# --- Seguranca ---
# Gerar uma chave NOVA, nao reaproveitar a de dev:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Gerar uma chave NOVA (Fernet), nao reaproveitar a de dev:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Importante: trocar essa chave invalida os refresh_token das contas Google ja
# conectadas (foram criptografados com a chave antiga) -- reconectar do zero
# em Configuracoes depois do deploy e esperado, nao e bug.
SECRET_ENCRYPTION_KEY=

# --- Debug (NAO ESQUECER) ---
# Falso em producao, sempre. O default no codigo ja e 'false' agora (ver
# config.py), mas deixa explicito aqui mesmo assim -- documentacao nao deve
# depender de "confiar no default".
FLASK_DEBUG=false

# --- OAuth Google ---
# Mesmo Client ID/Secret do Google Cloud Console, OU um novo se preferir
# separar credencial de dev e producao (mais seguro, mas opcional).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Aponta pro dominio de producao do BACKEND (Render), nao mais localhost.
# Precisa estar cadastrado como redirect URI autorizado no Google Cloud Console
# (tela de credenciais OAuth), senao o Google recusa com redirect_uri_mismatch.
GOOGLE_OAUTH_REDIRECT_URI=https://SEU-BACKEND.onrender.com/api/v1/oauth/google/callback

# --- CORS / redirect pos-login ---
# Dominio de producao do FRONTEND publicado (Etapa 8) -- usado tanto pro CORS
# (Etapa 4) quanto pro redirect de volta apos o OAuth do Google.
FRONTEND_URL=https://SEU-FRONTEND.dominio.com

# --- Porta ---
# O Render define a porta via variavel PORT propria dele, nao API_PORT --
# so mexe nisso na Etapa 7 (quando o servidor WSGI de producao for escolhido).
API_PORT=8000