{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hub-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "HubBackend",
      "image": "../backend/Dockerfile",
      "image_build_context": "../backend",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB_BACKEND",
        "class_name": "HubBackend"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["HubBackend"],
      "tag": "v1"
    }
  ]
}
